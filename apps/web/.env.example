# REFLEXCHAIN web app configuration.
#
# Leave everything unset for a local demo: the app derives the coordinator and
# validator endpoints from the protocol's own port scheme against the host it
# was served from.

# Point the dashboard at a network on another machine (e.g. a laptop on the
# venue wifi). Host only - ports come from the protocol config.
# NEXT_PUBLIC_NETWORK_HOST=192.168.1.42

# Full override for the coordinator (Socket.IO).
# NEXT_PUBLIC_COORDINATOR_URL=http://192.168.1.42:4000

# Full override for the validator set, comma separated, in ordinal order.
# NEXT_PUBLIC_VALIDATOR_URLS=http://192.168.1.42:7001,http://192.168.1.42:7002,http://192.168.1.42:7003,http://192.168.1.42:7004,http://192.168.1.42:7005

# NOTE ON HOSTING
# A hosted build (Vercel) has no validator network behind it. It detects that,
# shows LIVE NETWORK: NOT CONNECTED, and renders public/snapshot.json - a real
# chain exported from a live session - clearly labelled ARCHIVED SNAPSHOT.
# Regenerate it with:  npm run snapshot
